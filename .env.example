# Firebase Admin - emulator for local dev...
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=demo-stockline
# ...or a service account in production
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# PrestaShop Webservice (Advanced Parameters > Webservice), needs GET/PUT on
# orders, products, combinations, stock_availables
PS_URL=https://shop.example.com
PS_API_KEY=
PS_TIMEZONE=Europe/Tbilisi
# order states that hold stock, comma separated (defaults to the PrestaShop built-ins)
# PS_RESERVING_STATES=1,2,3,9,10,11,12

# bearer token the warehouse system sends
WAREHOUSE_SYNC_TOKEN=change-me
# bearer token for /api/cron/*
CRON_TOKEN=change-me
# dashboard password (basic auth, any username)
ADMIN_PASSWORD=change-me
